<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- No pacote as DLLs ficam em lib\ (a raiz só tem o exe, os .config e o Atualizador); na compilação ficam ao lado do exe e também funcionam -->
      <probing privatePath="lib" />
    </assemblyBinding>
  </runtime>
</configuration>
