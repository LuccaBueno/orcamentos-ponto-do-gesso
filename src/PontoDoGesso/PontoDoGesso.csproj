<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PontoDoGesso</RootNamespace>
    <AssemblyName>PontoDoGesso</AssemblyName>
    <ApplicationIcon>..\..\assets\icone-app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="[2.1.35]" />
    <PackageReference Include="PDFsharp-GDI" Version="[6.2.4]" />
    <PackageReference Include="System.Data.SQLite.Core" Version="[1.0.119]" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Dados\Migracoes\*.sql" LogicalName="Migracoes.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\assets\icone-whatsapp.png')">
    <!-- Ícone do WhatsApp ao lado do telefone no orçamento: opcional, fornecido pelo Lucca -->
    <None Include="..\..\assets\icone-whatsapp.png" Link="assets\icone-whatsapp.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
